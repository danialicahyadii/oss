APP_ENV=local
APP_PORT=8080

# =========================================================
# MYSQL - EXISTING LOCAL MYSQL
# =========================================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_oss
DB_USERNAME=root
DB_PASSWORD=


# =========================================================
# VALKEY
# AWS: ElastiCache for Valkey
# =========================================================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0


# =========================================================
# RABBITMQ
# AWS: Amazon MQ for RabbitMQ
# =========================================================

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbit_oss
RABBITMQ_PASSWORD=rabbit_oss
RABBITMQ_VHOST=rabbit_oss


# =========================================================
# S3 / MINIO
# AWS: Amazon S3
# =========================================================

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123456
S3_BUCKET=s3_oss
S3_USE_PATH_STYLE=true


# =========================================================
# SMTP
# Local: Mailpit
# AWS: Amazon SES
# =========================================================

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@oss.local


# =========================================================
# JWT
# =========================================================

JWT_SECRET=change-this-secret
JWT_EXPIRE_HOURS=24
